#!/usr/bin/env bash

first=$(git-first-branch-commit)
[[ -z $first ]] && echo 'Invalid commit returned, aborting.' && exit
dotfiles-debug-log "first branch commit: ${first}"

if git show --oneline "${first}~" &>/dev/null; then
	commits=$(git log "${first}~"..HEAD --oneline)
else
	commits=$(git log --root --oneline)
fi
dotfiles-debug-log "commits: ${commits}"

echo "${commits}" | fzf | cut -d' ' -f1
